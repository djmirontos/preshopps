# Supabase — public, safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase — server-only, never expose to the browser
# Used by lib/supabase/service-role.ts, imported only by the two
# cron-invoked email/reminder route handlers (app/api/cron/*).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (Resend) — server-only, never expose to the browser.
# RESEND_API_KEY is intentionally left unset until a real Resend
# account/domain exists: with it unset, email_outbox enqueueing and the
# processor route still run normally, but every send attempt reports a
# clear "not configured" failure and is retried/eventually marked failed
# -- it never blocks or rolls back the underlying order/moderation action.
RESEND_API_KEY=
# "Name <verified-sender@your-domain>" once a Resend domain is verified.
EMAIL_FROM_ADDRESS=
# Shared secret the two /api/cron/* route handlers require in an
# `Authorization: Bearer <value>` header. Both routes reject every
# request with 401 while this is unset -- never leave it blank in any
# environment that should actually run the cron jobs.
CRON_SECRET=
# Optional, non-production only (see lib/email/env.ts) — when set, every
# outgoing email is redirected to this address instead of the real
# recipient. Never applied when NODE_ENV=production, regardless of
# whether this is set.
EMAIL_TEST_RECIPIENT_OVERRIDE=
